{
  "expo": {
    "name": "Koan",
    "slug": "koan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "koan",
    "splash": {
      "backgroundColor": "#FAFDFA",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getkoan.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Koan uses health data to understand your movement, sleep, and energy patterns and deliver more relevant nudges.",
        "NSHealthUpdateUsageDescription": "Koan does not write to Health.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "backgroundModes": ["healthkit", "fetch"],
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.getkoan.app",
          "group.com.getkoan.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6B4E"
      },
      "package": "com.koan.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withHealthKitBackgroundDelivery",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A8D7F0",
          "sounds": []
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Koan uses health data to understand your movement, sleep, and energy patterns and deliver more relevant nudges.",
          "healthUpdatePermission": "Koan does not write to Health."
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "J3W8B3M59W",
          "devTeamId": "J3W8B3M59W",
          "appGroup": "group.com.getkoan.app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff1d935e-a6dd-493d-b3ca-9620410e93be",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.getkoan.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.getkoan.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.getkoan.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.getkoan.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.getkoan.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.getkoan.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
