EXPO_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Google OAuth client ID — create at console.cloud.google.com → APIs & Services → Credentials
# Use the "Web application" type; add your Expo redirect URI to Authorized redirect URIs
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# RevenueCat API key — create at app.revenuecat.com → Project → API Keys → Public (iOS or Android)
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
